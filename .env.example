# NOEMA Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env

# Anthropic API key (optional — needed for Claude-based memory consolidation)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Optional: override consolidation model
# CIEL_CONSOLIDATOR_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# CIEL memories access password (optional)
# CIEL_MEMORIES_PASSWORD=your_password
