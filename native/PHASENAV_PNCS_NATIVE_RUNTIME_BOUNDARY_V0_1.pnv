PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

# NOEMA release admission is explicitly DENIED until a truly native PNV/PNCS
# executor, exact 36D math, lexical negation, order semantics and independent
# receipts are all implemented and tested.
# No simulated ACTIVE tether value is embedded in source.
# This program uses only admitted callback-free PNV/1 built-ins.
# This source does not contain Python.
# RELEASE_STATUS BLOCKED
# EFFECTS FALSE
# EXTERNAL_RUNTIME_AUTHORITY FALSE

OP GATE.RELEASE.ADMISSION SOURCE FALSE
OP GATE.NATIVE.NUMERICS SOURCE FALSE
OP GATE.NATIVE.TOKENIZATION SOURCE FALSE
OP GATE.NATIVE.T36 SOURCE FALSE
OP GATE.END_TO_END SOURCE FALSE
OP GATE.UNVERIFIED.ORDER ORDER GATE.NATIVE.NUMERICS GATE.NATIVE.TOKENIZATION GATE.NATIVE.T36 GATE.END_TO_END
OP GATE.BLOCKED.IDENTITY IDENTITY GATE.RELEASE.ADMISSION FALSE
OP GATE.RELEASE.RECEIPT COMPOSITION GATE.RELEASE.ADMISSION GATE.UNVERIFIED.ORDER
ASSERT GATE.BLOCKED.IDENTITY
EMIT GATE.RELEASE.RECEIPT
